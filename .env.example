# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
OWNER_TELEGRAM_ID=0

# Fernet AES-128 key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BOT_ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE

# Database (leave blank for local SQLite, or set Neon/Supabase PostgreSQL / MSSQL URL)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional Owner Read-Only Trading 212 API credentials
T212_API_KEY=
T212_API_SECRET=
T212_ENV=live

# Optional Owner initial profile defaults (can also be configured inside Telegram via /set_budget and /set_loan)
OWNER_MONTHLY_INCOME=0
OWNER_INVEST_BUDGET=0
OWNER_BUFFER_CURRENT=0
OWNER_BUFFER_TARGET=500
OWNER_PAYDAY_DAY=1
# OWNER_LOAN_JSON={"lender_name":"MyBank","principal_balance":1000,"apr_percent":15.0,"regular_payment":100,"early_principal_payment":50,"due_day":15}

# Optional Gemini API Key (users can also set their own encrypted key directly in Telegram via /set_gemini_key)
GEMINI_API_KEY=
